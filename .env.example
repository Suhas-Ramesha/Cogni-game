# Copy to apps/api/.env, apps/dashboard/.env.local, and apps/mobile/.env as needed.

# --- PostgreSQL ---
DATABASE_URL=postgresql://cognigame:cognigame@127.0.0.1:5432/cognigame
DATABASE_URL_TEST=postgresql://cognigame:cognigame@127.0.0.1:5432/cognigame_test

# --- API ---
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Demo auth (SIH / local). NEVER true in production. ---
DEMO_AUTH=true
DEMO_JWT_SECRET=change-me-in-production-use-long-random
NEXT_PUBLIC_DEMO_AUTH=true
EXPO_PUBLIC_DEMO_AUTH=true

# --- Firebase (production OTP). Leave empty in demo mode. ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# --- Difficulty microservice ---
DIFFICULTY_SERVICE_URL=http://127.0.0.1:8001
INTERNAL_SERVICE_KEY=dev-internal-key
DIFFICULTY_PORT=8001

# --- Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:3001
DASHBOARD_PORT=3000

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:3001

# --- Asset updates (optional; games ship bundled) ---
FIREBASE_STORAGE_BUCKET=
AWS_S3_BUCKET=
AWS_REGION=
