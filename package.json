{
  "name": "cognigame-ner",
  "private": true,
  "version": "0.9.0",
  "description": "Offline-first cognitive gaming and memory assistance for elderly dementia patients in NER India",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:api": "pnpm --filter @cognigame/api start:dev",
    "dev:dashboard": "pnpm --filter @cognigame/dashboard dev",
    "dev:mobile": "pnpm --filter @cognigame/mobile start",
    "dev:difficulty": "pnpm --filter @cognigame/difficulty-service start",
    "db:migrate": "pnpm --filter @cognigame/api prisma:migrate",
    "db:seed": "pnpm --filter @cognigame/api prisma:seed",
    "db:generate": "pnpm --filter @cognigame/api prisma:generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "esbuild",
      "unrs-resolver",
      "protobufjs",
      "@firebase/util",
      "esbuild",
      "@prisma/engines"
    ]
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
